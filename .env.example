# 이 파일을 .env.local로 복사해서 사용한다. (.env.local은 git에 올라가지 않는다)
# 운영(Vercel)에서는 같은 이름으로 Vercel 프로젝트의 환경 변수에 넣는다. → docs/deploy.md

# 로컬: docker-compose.yml의 개발용 DB / 운영: Neon 연결 주소 (Vercel–Neon 연동 시 자동 설정)
DATABASE_URL=postgres://household:household@localhost:5432/household_hub

# 세션 서명용 비밀값 (32자 이상 무작위). 만들기: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# 사이트 주소. 로컬은 아래 값, Vercel에서는 비워 두면 자동으로 정해진다
BETTER_AUTH_URL=http://localhost:3000

# 가족이 모두 가입한 뒤 false로 바꾸면 새 가입을 막는다 (기본 true)
# SIGNUP_ENABLED=true
